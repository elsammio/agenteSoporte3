{
  "name": "desktop-agent",
  "productName": "Desktop Agent",
  "version": "0.1.0",
  "description": "Asistente flotante e interactivo para Windows, inspirado en Microsoft Agent, construido con Electron.",
  "main": "src/main/main.js",
  "author": "Samir",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.samir.desktopagent",
    "productName": "Desktop Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
